  "name": "BMW G30 / G31 F90 M Cluster",
  "version": "0.1.0",
  "author": "santtiaga",
  "description": "F90 M-inspired cluster for BMW G31 LCI 520d B47D20B 48V MHEV Stage 1 (245 hp / 528 Nm), with a non-linear 0–5000 rpm tachometer.",
  "license": "GPL-3.0-or-later",
