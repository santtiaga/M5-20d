  "palettes": {
    "night": {
      "name": "Night",
      "colors": {
        "background": "#000000",
        "surface": "#111419",
        "text": "#f2f4f7",
        "text-muted": "#8a93a1",
        "accent": "#3f8cff",
        "track": "#1c2129",
        "success": "#3ddc84",
        "warning": "#ffb020",
        "danger": "#ff3b3b",
        "cold": "#4fb3ff"
      }
    },
    "sport": {
      "name": "Sport",
      "colors": {
        "background": "#000000",
        "surface": "#17100f",
        "text": "#ffffff",
        "text-muted": "#a4908c",
        "accent": "#ff3a2d",
        "track": "#2a1b18",
        "success": "#3ddc84",
        "warning": "#ffb020",
        "danger": "#ff3b3b",
        "cold": "#4fb3ff"
      }
    },
    "track": {
      "name": "Track",
      "colors": {
        "background": "#000000",
        "surface": "#141414",
        "text": "#ffffff",
        "text-muted": "#9a9a9a",
        "accent": "#ffd400",
        "track": "#262626",
        "success": "#3ddc84",
        "warning": "#ffb020",
        "danger": "#ff3b3b",
        "cold": "#4fb3ff"
      }
    }
  },
  "palette": {
    "default": "night",
    "byDriveMode": {
      "SPORT": "sport",
      "SPORT_PLUS": "sport",
      "TRACK": "track"
    },
    "allowManual": true
  },
  "fonts": {
    "default": {
      "family": "sans"
    }
  },
  "assets": {},
  "animations": {
    "fade-in": {
      "name": "Fade in",
      "duration": 700,
      "easing": "ease-out-cubic",
      "loop": false,
      "direction": "normal",
      "tracks": [
        {
          "property": "opacity",
          "keyframes": [
            {
              "t": 0,
              "value": 0
            },
            {
              "t": 1,
              "value": 1
            }
          ]
        }
      ]
    },
    "redline-pulse": {
      "name": "Redline pulse",
      "duration": 260,
      "easing": "ease-in-out",
      "loop": true,
      "direction": "alternate",
      "tracks": [
        {
          "property": "props.style.color",
          "keyframes": [
            {
              "t": 0,
              "value": "#ffffff"
            },
            {
              "t": 1,
              "value": "#ff3b3b"
            }
          ]
        }
      ]
    }
  },
  "components": [
    {
      "id": "bg",
      "name": "Background",
      "type": "rect",
      "x": 0,
      "y": 0,
      "width": 1920,
      "height": 720,
      "locked": true,
      "props": {
        "fill": "$background"
      }
    },
    {
      "id": "shift-lights",
      "name": "Diesel shift lights",
      "type": "indicator.shiftlights",
      "x": 660,
      "y": 134,
      "width": 600,
      "height": 26,
      "binding": {
        "signal": "engine.rpm",
        "min": 0,
        "max": 5000
      },
      "props": {
        "count": 10,
        "shape": "pill",
        "gap": 6,
        "from": 3600,
        "to": 5000,
        "flashAbove": 4800,
        "flashRateHz": 7,
        "colors": [
          "$success",
          "$success",
          "$success",
          "$warning",
          "$warning",
          "$warning",
          "$danger",
          "$danger",
          "$danger",
          "$danger"
        ],
        "offColor": "$track",
        "symmetric": false,
        "glow": true
      }
    },
    {
      "id": "tacho",
      "name": "F90 nonlinear GPU tachometer",
      "type": "gauge.arc",
      "x": 710,
      "y": 150,
      "width": 500,
      "height": 500,
      "binding": {
        "signal": "engine.rpm",
        "min": 0,
        "max": 5000,
        "smoothing": 0.035
      },
      "props": {
        "startAngle": 135,
        "sweepAngle": 270,
        "scale": {
          "value1": 2000,
          "value2": 4500,
          "position1": 0.32,
          "position2": 0.92
        },
        "track": {
          "show": true,
          "color": "$track",
          "width": 18,
          "cap": "butt"
        },
        "fill": {
          "show": true,
          "color": "$accent",
          "width": 18,
          "mode": "solid",
          "cap": "butt",
          "zones": [
            {
              "from": 0,
              "to": 2000,
              "color": "$success"
            },
            {
              "from": 2000,
              "to": 4000,
              "color": "$accent"
            },
            {
              "from": 4000,
              "to": 4500,
              "color": "$warning"
            },
            {
              "from": 4500,
              "to": 5000,
              "color": "$danger"
            }
          ]
        },
        "ticks": {
          "major": 0
        },
        "labels": {
          "show": false
        },
        "needle": {
          "show": true,
          "color": "$text",
          "width": 5,
          "length": 0.88,
          "tail": 0.08,
          "shape": "tapered",
          "cap": {
            "show": true,
            "radius": 14,
            "color": "$surface"
          }
        },
        "redline": {
          "show": false
        },
        "valueText": {
          "show": false
        },
        "glow": {
          "show": false,
          "color": "$warning",
          "blur": 8
        }
      }
    },
    {
      "id": "rpm-label-0",
